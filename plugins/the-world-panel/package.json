{
  "name": "the-world-panel",
  "version": "0.1.0",
  "description": "The World 只读游戏面板（Gate B 首个 RPG 体验插件）：better-sidebar 宿主的角色/人物/系统/任务四分页，数据经 Node 半从 game workspace 投影，永远只读。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "license": "MIT"
}
